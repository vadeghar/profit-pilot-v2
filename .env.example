# Postgres (Prisma) connection string
# DATABASE_URL=postgres://7e7b1cfed6cd7871e3432052779c6a4ccb63d4fa802a9103a90b30e4f5453f00:sk_NHULGk-WNOE3Nt5qLA0sH@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:admin@localhost:5432/postgres

# Angel One SmartAPI credentials
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD_OR_MPIN=
ANGEL_TOTP_SECRET=


# ICICI Direct Breeze API credentials
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_USER_ID=
BREEZE_PASSWORD=
BREEZE_TOTP_SECRET=
# Optional: paste a session token you already have (from api.icicidirect.com/apiuser/login)
# to skip the Selenium auto-login entirely. Breeze session tokens typically expire
# daily, so you'll need to refresh this value each day you run the script this way.
BREEZE_SESSION_TOKEN=


# NCAS broker endpoint — placeholder, NO real secrets.
# Actual credentials live only in local .env (not committed).
BROKER_WS_URL=wss://broker.local
BROKER_KEY=REDACTED
# DuckDB database path (used by all data scripts)
DUCKDB_PATH=https://github.com/vadeghar/my-duckdb-data/releases/download/v1/market_data.duckdb
