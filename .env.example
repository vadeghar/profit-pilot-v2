# =============================================================================
# Trading Strategy Execution Platform - .env.example
# =============================================================================
# Copy this file to `.env` at the project root and fill in real values:
#     cp .env.example .env
#
# The platform reads `.env` from the project root (platform_config.ENV_FILE).
# The parser is intentionally simple (KEY=VALUE per line). Rules:
#   - Lines starting with `#` are comments (ignored).
#   - Blank lines are ignored.
#   - Values are split on the FIRST `=` and stripped of surrounding whitespace.
#   - No quoting / interpolation support (e.g. `KEY="value"` keeps the quotes).
#
# Keep `.env` OUT of version control — it holds live secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# ICICI Breeze (ICICIDirect)  — used by brokers/icici.py,
#   lorentzian_strategy/data_loader.py (connect_breeze) and
#   tools/breeze/breeze_auto_login.py
# -----------------------------------------------------------------------------

# Breeze API key (from api.icicidirect.com developer portal).
BREEZE_API_KEY=your_breeze_api_key

# API secret used together with the session token to authenticate
# (generate_session). Required by connect_breeze() and the auto-login script.
BREEZE_API_SECRET=your_breeze_api_secret

# Breeze login user ID (client code) — required by the auto-login script.
BREEZE_USER_ID=your_breeze_user_id

# Breeze login password — required by the auto-login script.
BREEZE_PASSWORD=your_breeze_password

# Fresh daily session token. Obtain it by running:
#     python tools/breeze/breeze_auto_login.py --visible
# The auto-login script captures and writes this value back into `.env`.
# Required by connect_breeze() (lorentzian strategy) and the ICICI broker.
BREEZE_SESSION_TOKEN=

# Optional: date of birth DD/MM/YYYY, only if the Breeze login flow asks for it.
#BREEZE_DOB=DD/MM/YYYY


# -----------------------------------------------------------------------------
# Angel One SmartAPI  — used by brokers/angel_one.py,
#   execution/forward_test_runner.py, market_data/* and web_app.py paper sessions
# -----------------------------------------------------------------------------

# Angel One API key (from SmartAPI developer console).
ANGEL_API_KEY=your_angel_api_key

# Angel One client code / login ID (e.g. S948479).
ANGEL_CLIENT_CODE=your_angel_client_code

# Angel One login password or 6-digit MPIN (whichever your account uses).
ANGEL_PASSWORD_OR_MPIN=your_angel_password_or_mpin

# Base32 TOTP secret used to generate the 6-digit OTP at login
# (backed up from the Angel One app / SmartAPI console).
ANGEL_TOTP_SECRET=your_angel_totp_secret


# -----------------------------------------------------------------------------
# Telegram  — used for signal dispatch (utils/telegram.py) and Breeze OTP flow
#   (tools/breeze/breeze_auto_login.py, execution/forward_test_runner.py)
# -----------------------------------------------------------------------------

# Bot token from @BotFather (e.g. 1234567890:AAxxxx...).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram chat/channel ID that receives signals. Used as the primary chat ID
# for the Breeze OTP flow and forward-test notifications.
TELEGRAM_HOME_CHANNEL=your_telegram_home_channel

# Fallback alias for the chat ID (breeze_auto_login reads this if
# TELEGRAM_HOME_CHANNEL is missing).
#TELEGRAM_CHAT_ID=your_telegram_chat_id

# Comma-separated Telegram user IDs allowed to interact with the bot
# (access control; documented in docs/BROKER_CREDENTIALS.md).
#TELEGRAM_ALLOWED_USERS=111111111,222222222


# -----------------------------------------------------------------------------
# Web app  — used by web_app.py (`__main__` uvicorn block)
# -----------------------------------------------------------------------------

# HTTP port for the FastAPI dashboard when launched via `python web_app.py`.
# run_strategy.sh `web` / scripts/start_dashboard.sh default to 8080; a
# plain `python web_app.py` defaults to 9090 when PORT is unset.
PORT=8080


# -----------------------------------------------------------------------------
# TLS / CA bundle  (usually NOT required — auto-managed)
# -----------------------------------------------------------------------------
# brokers/icici.py, tools/breeze/* and lorentzian_strategy/data_loader.py
# automatically point OpenSSL/requests at certifi's CA bundle when they need it
# (SSL_CERT_FILE / REQUESTS_CA_BUNDLE are set via os.environ.setdefault).
# Only override if you need a custom CA chain:
#SSL_CERT_FILE=/path/to/custom-ca-bundle.pem
#REQUESTS_CA_BUNDLE=/path/to/custom-ca-bundle.pem