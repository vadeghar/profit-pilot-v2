# Daily ICICI Breeze session refresh (headless Playwright; the OTP is requested via Telegram).
# Installed with deploy/linux/breeze-login.timer. Log: journalctl -u breeze-login
# To keep another project on the same Breeze account in sync, uncomment SYNC_ENV_FILES.

[Unit]
Description=Refresh the ICICI Breeze session token
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=TZ=Asia/Kolkata
Environment=PYTHONUNBUFFERED=1
# Environment="SYNC_ENV_FILES=/home/__USER__/.hermes/.env"
ExecStart=/bin/bash __APP_DIR__/deploy/linux/breeze_login.sh
TimeoutStartSec=600
